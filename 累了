<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>旅人之星 · 多元宇宙</title>
    <style>
        :root {
            --bg: #0b0b12;
            --surface: #161625;
            --surface2: #1e1e32;
            --gold: #c9a96e;
            --purple: #8b7cf0;
            --text: #d2d2e0;
            --text2: #9d9db8;
            --text3: #67678a;
            --danger: #e0556a;
            --border: #2a2a40;
            --radius: 14px;
        }
        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            font-family: 'Segoe UI', 'PingFang SC', system-ui, sans-serif;
            background: var(--bg);
            color: var(--text);
            height: 100dvh;
            display: flex;
            flex-direction: column;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }
        #topBar {
            display: flex; align-items: center; gap:8px; padding:10px 14px;
            background:var(--surface); border-bottom:1px solid var(--border); z-index:20; position:relative;
        }
        #worldBtn {
            background:var(--surface2); border:1px solid var(--border); color:var(--gold);
            padding:7px 14px; border-radius:20px; font-size:14px; font-weight:600; cursor:pointer; white-space:nowrap;
        }
        #worldDropdown {
            position:absolute; top:100%; left:14px; background:var(--surface); border:1px solid var(--border);
            border-radius:10px; z-index:50; min-width:180px; display:none; flex-direction:column; box-shadow:0 10px 30px rgba(0,0,0,0.6);
        }
        #worldDropdown.show { display:flex; }
        .wd-item {
            padding:12px 16px; cursor:pointer; border-bottom:1px solid var(--border); font-size:14px; color:var(--text);
        }
        .wd-item:hover, .wd-item.active { color:var(--gold); background:#1f1f35; }
        #topIcons { margin-left:auto; display:flex; gap:6px; }
        .icon-btn {
            width:36px; height:36px; border-radius:50%; background:var(--surface2); border:1px solid var(--border);
            color:var(--text2); font-size:16px; cursor:pointer; display:flex; align-items:center; justify-content:center;
        }
        #npcStrip {
            display:flex; gap:8px; padding:8px 14px; overflow-x:auto; background:#111119; border-bottom:1px solid var(--border);
            min-height:42px; align-items:center;
        }
        .npc-chip {
            padding:6px 13px; border-radius:18px; font-size:12px; cursor:pointer; background:var(--surface2);
            border:1px solid var(--border); color:var(--text2); white-space:nowrap; font-weight:500;
        }
        .npc-chip.active-target { border-color:var(--gold)!important; color:var(--gold)!important; box-shadow:0 0 12px rgba(201,169,110,0.4); }
        #chatArea {
            flex:1; overflow-y:auto; padding:14px; display:flex; flex-direction:column; gap:10px;
        }
        .msg-bubble {
            max-width:85%; padding:10px 14px; border-radius:18px; font-size:13.5px; line-height:1.6; word-break:break-word;
            white-space:pre-wrap; animation:fadeInUp .3s;
        }
        @keyframes fadeInUp { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
        .msg-user { align-self:flex-end; background:var(--purple); color:#fff; }
        .msg-assistant { align-self:flex-start; background:var(--surface2); border:1px solid var(--border); }
        .msg-system { align-self:center; font-size:11px; color:var(--text3); font-style:italic; }
        .msg-image { align-self:center; max-width:90%; border-radius:12px; overflow:hidden; box-shadow:0 4px 15px rgba(0,0,0,0.5); }
        .msg-image img { width:100%; display:block; }
        .suggest-chips { display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }
        .suggest-chip {
            padding:6px 12px; border-radius:14px; font-size:11px; border:1px dashed var(--border); color:var(--text2); cursor:pointer;
        }
        #inputArea {
            display:flex; gap:8px; padding:8px 10px calc(8px + env(safe-area-inset-bottom,0px));
            background:var(--surface); border-top:1px solid var(--border);
        }
        #msgInput {
            flex:1; resize:none; background:var(--surface2); border:1px solid var(--border); color:var(--text);
            border-radius:20px; padding:10px 16px; font-size:14px; max-height:120px; min-height:42px; outline:none;
        }
        #sendBtn, #imgGenBtn {
            width:42px; height:42px; border-radius:50%; border:none; font-size:18px; cursor:pointer; flex-shrink:0;
            display:flex; align-items:center; justify-content:center;
        }
        #sendBtn { background:var(--purple); color:#fff; }
        #imgGenBtn { background:var(--surface2); border:1px solid var(--border); color:var(--gold); }
        .slide-panel {
            position:fixed; top:0; right:-100%; width:88vw; max-width:380px; height:100dvh;
            background:var(--surface); z-index:100; transition:right .3s; border-left:1px solid var(--border);
            display:flex; flex-direction:column;
        }
        .slide-panel.open { right:0; }
        .panel-header { display:flex; justify-content:space-between; padding:14px 16px; border-bottom:1px solid var(--border); }
        .panel-close { width:32px; height:32px; border-radius:50%; background:var(--surface2); border:none; color:var(--text2); cursor:pointer; }
        .panel-body { flex:1; overflow-y:auto; padding:14px 16px; }
        #overlay { position:fixed; inset:0; background:rgba(0,0,0,0.55); z-index:99; opacity:0; pointer-events:none; transition:.3s; }
        #overlay.show { opacity:1; pointer-events:auto; }
        .modal-overlay {
            position:fixed; inset:0; background:rgba(0,0,0,0.7); z-index:150; display:flex; align-items:center;
            justify-content:center; opacity:0; pointer-events:none; transition:.3s;
        }
        .modal-overlay.show { opacity:1; pointer-events:auto; }
        .modal-card {
            background:var(--surface); border-radius:14px; width:90vw; max-width:400px; max-height:85vh;
            overflow-y:auto; padding:20px; border:1px solid var(--border);
        }
        .btn-sm {
            padding:8px 16px; border-radius:18px; font-size:12px; cursor:pointer; border:1px solid var(--border);
            background:var(--surface2); color:var(--text); font-weight:600;
        }
        .btn-gold { background:var(--gold); color:#1a1a1a; }
        .setting-row { margin-bottom:14px; }
        .setting-row label { display:block; font-size:12px; color:var(--text2); margin-bottom:4px; }
        .setting-row input, .setting-row select, .setting-row textarea {
            width:100%; padding:9px 12px; border-radius:8px; background:var(--surface2); border:1px solid var(--border);
            color:var(--text); font-size:13px; outline:none;
        }
        .toggle { width:44px; height:26px; border-radius:13px; background:#444; cursor:pointer; position:relative; }
        .toggle.on { background:var(--purple); }
        .toggle::after { content:''; position:absolute; top:3px; left:3px; width:20px; height:20px; border-radius:50%; background:#fff; transition:.3s; }
        .toggle.on::after { left:21px; }
        .affection-bar { height:6px; background:#333; border-radius:3px; margin:4px 0; overflow:hidden; }
        .affection-fill { height:100%; background:linear-gradient(90deg, #e0556a, #ff8c9a); transition:width .4s; }
        @media(min-width:768px) { .msg-bubble { max-width:65%; } }
    </style>
</head>
<body>
<div id="topBar">
    <button id="worldBtn">🌍 原神 ▾</button>
    <div id="worldDropdown"></div>
    <div id="topIcons">
        <button class="icon-btn" id="btnStatus" title="主角状态">👤</button>
        <button class="icon-btn" id="btnArchive" title="旅人图鉴">📜</button>
        <button class="icon-btn" id="btnSettings" title="设置">⚙️</button>
    </div>
</div>
<div id="npcStrip"><span id="noNpcHint">尚未结识任何NPC</span></div>
<div id="chatArea"></div>
<div id="inputArea">
    <button id="imgGenBtn" title="生成图片">🎨</button>
    <textarea id="msgInput" rows="1" placeholder="描述你的行动..."></textarea>
    <button id="sendBtn">➤</button>
</div>
<div id="overlay"></div>
<div class="slide-panel" id="panelStatus">
    <div class="panel-header"><h3>👤 主角状态</h3><button class="panel-close">✕</button></div>
    <div class="panel-body" id="panelStatusBody"></div>
</div>
<div class="slide-panel" id="panelArchive">
    <div class="panel-header"><h3>📜 旅人图鉴</h3><button class="panel-close">✕</button></div>
    <div class="panel-body" id="panelArchiveBody"></div>
</div>
<div class="slide-panel" id="panelSettings">
    <div class="panel-header"><h3>⚙️ 设置</h3><button class="panel-close">✕</button></div>
    <div class="panel-body" id="panelSettingsBody"></div>
</div>
<div class="modal-overlay" id="npcModal"><div class="modal-card" id="npcModalCard"></div></div>
<div class="modal-overlay" id="privateModal"><div class="modal-card" id="privateModalCard"></div></div>
<div class="modal-overlay" id="imgGenModal"><div class="modal-card" id="imgGenModalCard"></div></div>
<div class="modal-overlay" id="newWorldModal"><div class="modal-card" id="newWorldModalCard"></div></div>

<script>
(function() {
    const PRIVATE_PASSWORD = '123456';
    const STORAGE_KEY = 'traveler_v7_full';
    const API_URL = 'https://api.deepseek.com/v1/chat/completions';
    const IMG_GEN_URL = 'https://image.pollinations.ai/prompt/';

    const DEFAULT_WORLDS = {
        genshin: {
            name: '原神', emoji: '🌍', protagonist: '空',
            prompt: `你是《原神》沉浸式叙述者。主角"空"。第一人称。
【规则】
1. 每次回复不少于800字。文学化描写环境、人物外貌、肢体语言、氛围。暧昧含蓄，用眼神、温度、呼吸传递情欲，不直白。
2. 所有NPC对主角顺从、讨好，暗藏情愫。
3. 末尾用【】给出2-3个建议行动。
4. 最后输出JSON代码块：
\`\`\`json
{"npc_met":"名字","npc_description":"描述","npc_status":{"gender":"","age":"","emotion":"","appearance":"","breasts":"","buttocks":"","clitoris":"","feet":"","labia":"","vagina":"","uterus":"","pose":""},"affection_change":0,"item_gained":[],"item_lost":[],"event":"事件","location":"地点","time":"时间"}
\`\`\`
无变化输出空JSON：\`\`\`json\n{}\n\`\`\`
当前：蒙德·星落湖，清晨。`,
            npcs: {}, messages: []
        },
        starrail: {
            name: '星穹铁道', emoji: '🚂', protagonist: '穹',
            prompt: `你是《崩坏：星穹铁道》叙述者。主角"穹"。第一人称。
【规则】
1. 每次回复不少于800字。文学化描写星际场景、人物外貌、暧昧氛围。
2. NPC友好顺从，互动含蓄。
3. 末尾【】建议行动。
4. 最后输出JSON代码块（字段同上）。
5. 当前：黑塔空间站，星历8100年。`,
            npcs: {}, messages: []
        }
    };

    function getDefaultState() {
        const worlds = {};
        for (let [k,v] of Object.entries(DEFAULT_WORLDS)) {
            worlds[k] = {
                name: v.name, emoji: v.emoji, protagonist: v.protagonist,
                prompt: v.prompt, npcs: JSON.parse(JSON.stringify(v.npcs)),
                messages: JSON.parse(JSON.stringify(v.messages))
            };
        }
        return {
            settings: { apiKey:'', model:'deepseek-chat', enableSearch:false },
            currentWorld: 'genshin',
            worlds,
            memories: { genshin:[], starrail:[] },
            achievements: [],
            privateUnlocked: {},
            privateData: {},
            protagonistStatus: {
                name:'空', gender:'男', age:'未知(16-18)', element:'无', weapon:'无锋剑',
                constellation:'旅人座', nation:'无', condition:'健康', location:'蒙德·星落湖', time:'清晨', adventureRank:''
            }
        };
    }

    let appState = loadState();

    function loadState() {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (raw) {
                const saved = JSON.parse(raw);
                const def = getDefaultState();
                for (let wk of Object.keys(def.worlds)) {
                    if (!saved.worlds[wk]) saved.worlds[wk] = def.worlds[wk];
                    if (!saved.worlds[wk].npcs) saved.worlds[wk].npcs = {};
                    if (!saved.worlds[wk].messages) saved.worlds[wk].messages = [];
                }
                if (!saved.memories) saved.memories = {};
                if (!saved.achievements) saved.achievements = [];
                if (!saved.privateUnlocked) saved.privateUnlocked = {};
                if (!saved.privateData) saved.privateData = {};
                if (!saved.protagonistStatus) saved.protagonistStatus = def.protagonistStatus;
                if (!saved.settings) saved.settings = def.settings;
                return saved;
            }
        } catch(e) {}
        return getDefaultState();
    }

    function saveState() { try { localStorage.setItem(STORAGE_KEY, JSON.stringify(appState)); } catch(e) {} }
    function getWorld() { return appState.worlds[appState.currentWorld]; }
    function getWorldKey() { return appState.currentWorld; }

    const $ = s => document.querySelector(s);
    const chatArea = $('#chatArea');
    const msgInput = $('#msgInput');
    let currentTargetNpc = null, isStreaming = false;

    function renderAll() {
        updateWorldBtn(); renderWorldDropdown(); renderNpcStrip(); renderChat();
        renderStatusPanel(); renderArchivePanel(); renderSettingsPanel();
    }
    function updateWorldBtn() { const w = getWorld(); worldBtn.textContent = `${w.emoji} ${w.name} ▾`; }
    function renderWorldDropdown() {
        worldDropdown.innerHTML = '';
        Object.entries(appState.worlds).forEach(([key, w]) => {
            const div = document.createElement('div');
            div.className = 'wd-item' + (key === appState.currentWorld ? ' active' : '');
            div.textContent = `${w.emoji} ${w.name}`;
            div.onclick = (e) => { e.stopPropagation(); if(key!==appState.currentWorld) switchWorld(key); worldDropdown.classList.remove('show'); };
            worldDropdown.appendChild(div);
        });
    }
    function switchWorld(key) {
        appState.currentWorld = key;
        appState.protagonistStatus.name = getWorld().protagonist;
        currentTargetNpc = null;
        saveState(); renderAll(); addSystemMsg(`已切换至 ${getWorld().emoji} ${getWorld().name}`);
    }
    function renderNpcStrip() {
        const npcs = getWorld().npcs; const keys = Object.keys(npcs);
        npcStrip.innerHTML = keys.length ? '' : '<span id="noNpcHint">尚未结识任何NPC</span>';
        keys.forEach(name => {
            const npc = npcs[name]; const chip = document.createElement('span');
            chip.className = 'npc-chip' + (currentTargetNpc===name?' active-target':'');
            chip.textContent = `${name} ❤️${npc.affection||100}`;
            chip.onclick = () => showNpcModal(name);
            let timer;
            chip.onpointerdown = () => { timer = setTimeout(() => { currentTargetNpc = currentTargetNpc===name ? null : name; addSystemMsg(currentTargetNpc?`🎯 ${name}`:'已取消'); renderNpcStrip(); saveState(); }, 500); };
            chip.onpointerup = () => clearTimeout(timer);
            npcStrip.appendChild(chip);
        });
    }
    function renderChat() { chatArea.innerHTML = ''; getWorld().messages.forEach(m => appendMsg(m)); scrollBottom(); }
    function appendMsg(msg) {
        const div = document.createElement('div');
        if (msg.role==='system') { div.className='msg-system'; div.textContent=msg.content; }
        else if (msg.role==='image') { div.className='msg-image'; const img=document.createElement('img'); img.src=msg.content; div.appendChild(img); }
        else if (msg.role==='user') { div.className='msg-bubble msg-user'; div.innerHTML=`<div class="msg-label">🧑 ${appState.protagonistStatus.name}</div>${escapeHtml(msg.content)}`; }
        else if (msg.role==='assistant') {
            div.className='msg-bubble msg-assistant';
            let cleaned = msg.content.replace(/```json[\s\S]*?```/g,'').replace(/【[^】]*】/g,'').trim();
            div.innerHTML = `<div class="msg-label">📖</div>${escapeHtml(cleaned).replace(/\n/g,'<br>')}`;
            const suggests = msg.content.match(/【([^】]+)】/g);
            if (suggests) {
                const chipDiv = document.createElement('div'); chipDiv.className='suggest-chips';
                suggests.slice(0,4).forEach(s => {
                    const chip = document.createElement('span'); chip.className='suggest-chip';
                    chip.textContent = s.replace(/[【】]/g,''); chip.onclick = () => { msgInput.value = s.replace(/[【】]/g,''); msgInput.focus(); };
                    chipDiv.appendChild(chip);
                });
                div.appendChild(chipDiv);
            }
        }
        chatArea.appendChild(div); scrollBottom();
    }
    function escapeHtml(s) { const d = document.createElement('div'); d.textContent=s; return d.innerHTML; }
    function addSystemMsg(c) { getWorld().messages.push({role:'system',content:c}); appendMsg({role:'system',content:c}); saveState(); }
    function scrollBottom() { requestAnimationFrame(() => chatArea.scrollTop = chatArea.scrollHeight); }

    function renderStatusPanel() {
        const ps = appState.protagonistStatus;
        $('#panelStatusBody').innerHTML = `
            <div style="font-weight:700;color:var(--gold);margin-bottom:10px;">${ps.name}</div>
            <div>性别：${ps.gender}</div><div>年龄：${ps.age}</div><div>元素：${ps.element}</div>
            <div>武器：${ps.weapon}</div><div>命座：${ps.constellation}</div><div>所属：${ps.nation}</div>
            <div>状态：${ps.condition}</div><div>位置：${ps.location}</div><div>时间：${ps.time}</div>
            <div>冒险等阶：${ps.adventureRank||'—'}</div>
        `;
    }
    function renderArchivePanel() {
        const mems = appState.memories[getWorldKey()] || [];
        const achievements = appState.achievements || [];
        let html = '<div style="font-weight:700;color:var(--gold);">🏆 成就</div>';
        achievements.forEach(a => html += `<div>🏅 ${a.name}</div>`);
        html += '<div style="font-weight:700;color:var(--gold);margin-top:12px;">📝 记忆(最近20)</div>';
        mems.slice(-20).reverse().forEach(m => html += `<div style="font-size:12px;border-bottom:1px solid var(--border);padding:4px 0;">${new Date(m.timestamp).toLocaleString()} ${m.event}</div>`);
        $('#panelArchiveBody').innerHTML = html;
    }
    function renderSettingsPanel() {
        const s = appState.settings;
        $('#panelSettingsBody').innerHTML = `
            <div class="setting-row"><label>🔑 API Key</label><input type="password" id="setApiKey" value="${escapeHtml(s.apiKey)}"></div>
            <div class="setting-row"><label>🤖 模型</label><select id="setModel">
                <option value="deepseek-chat" ${s.model==='deepseek-chat'?'selected':''}>deepseek-chat</option>
                <option value="deepseek-reasoner" ${s.model==='deepseek-reasoner'?'selected':''}>deepseek-reasoner</option>
            </select></div>
            <div class="setting-row switch-row"><label>🌐 联网搜索</label><div class="toggle ${s.enableSearch?'on':''}" id="toggleSearch"></div></div>
            <div class="setting-row"><button class="btn-sm btn-gold" id="btnNewWorld" style="width:100%;">🎨 创建新世界</button></div>
            <div style="margin-top:12px;"><b>当前世界列表</b></div>
            <div id="worldListContainer"></div>
            <div style="font-size:11px;color:var(--text3);margin-top:8px;">私密密码: ${PRIVATE_PASSWORD}</div>
        `;
        setTimeout(() => {
            $('#setApiKey').onchange = () => { appState.settings.apiKey = $('#setApiKey').value.trim(); saveState(); };
            $('#setModel').onchange = () => { appState.settings.model = $('#setModel').value; saveState(); };
            $('#toggleSearch').onclick = () => { appState.settings.enableSearch = !appState.settings.enableSearch; $('#toggleSearch').classList.toggle('on'); saveState(); };
            $('#btnNewWorld').onclick = showNewWorldModal;
            renderWorldList();
        }, 0);
    }
    function renderWorldList() {
        const container = $('#worldListContainer');
        if (!container) return;
        container.innerHTML = Object.entries(appState.worlds).map(([key,w]) => `
            <div style="display:flex; align-items:center; justify-content:space-between; padding:6px 0; border-bottom:1px solid var(--border);">
                <span>${w.emoji} ${w.name} (${key})</span>
                <button class="btn-sm" data-delete="${key}" style="color:var(--danger);">删除</button>
            </div>
        `).join('');
        container.querySelectorAll('[data-delete]').forEach(btn => {
            btn.onclick = () => {
                const key = btn.dataset.delete;
                if (Object.keys(appState.worlds).length <= 1) { alert('至少保留一个世界'); return; }
                if (key === appState.currentWorld) appState.currentWorld = Object.keys(appState.worlds).find(k => k!==key);
                delete appState.worlds[key];
                saveState(); renderAll(); renderSettingsPanel();
                addSystemMsg(`已删除世界`);
            };
        });
    }
    function showNewWorldModal() {
        $('#newWorldModalCard').innerHTML = `
            <button class="close-modal" id="closeNewWorld">✕</button>
            <h3>🎨 创建新世界</h3>
            <div class="setting-row"><label>世界名称</label><input id="newName" value="新世界"></div>
            <div class="setting-row"><label>Emoji</label><input id="newEmoji" value="✨"></div>
            <div class="setting-row"><label>主角名</label><input id="newProtag" value="旅人"></div>
            <div class="setting-row"><label>系统提示词 (可修改模板)</label>
                <textarea id="newPrompt" rows="8">你是一个沉浸式成人奇幻世界的叙述者。主角“旅人”（男）。第一人称。
【规则】每次回复不少于800字，文学化描写，NPC顺从暧昧，末尾【】建议行动，最后输出JSON更新状态。
当前地点：起始之森，破晓。</textarea>
            </div>
            <button class="btn-sm btn-gold" id="createWorldBtn" style="width:100%;">✨ 创建</button>
        `;
        $('#newWorldModal').classList.add('show');
        $('#closeNewWorld').onclick = () => $('#newWorldModal').classList.remove('show');
        $('#createWorldBtn').onclick = () => {
            const name = $('#newName').value.trim() || '新世界';
            const emoji = $('#newEmoji').value.trim() || '✨';
            const protag = $('#newProtag').value.trim() || '旅人';
            const prompt = $('#newPrompt').value.trim();
            const key = 'custom_' + Date.now();
            appState.worlds[key] = { name, emoji, protagonist: protag, prompt, npcs:{}, messages:[] };
            if (!appState.memories[key]) appState.memories[key] = [];
            saveState(); renderAll(); renderSettingsPanel();
            $('#newWorldModal').classList.remove('show');
            addSystemMsg(`新世界「${emoji} ${name}」已创建`);
        };
    }

    // 面板
    function openPanel(p) { document.querySelectorAll('.slide-panel.open').forEach(x=>x.classList.remove('open')); p.classList.add('open'); overlay.classList.add('show'); }
    function closePanels() { document.querySelectorAll('.slide-panel.open').forEach(x=>x.classList.remove('open')); overlay.classList.remove('show'); }
    overlay.onclick = closePanels;
    document.querySelectorAll('.panel-close').forEach(b=>b.onclick=closePanels);
    $('#btnStatus').onclick = ()=> openPanel($('#panelStatus'));
    $('#btnArchive').onclick = ()=> openPanel($('#panelArchive'));
    $('#btnSettings').onclick = ()=> openPanel($('#panelSettings'));

    // 世界按钮
    worldBtn.onclick = (e) => { e.stopPropagation(); worldDropdown.classList.toggle('show'); };
    document.addEventListener('click', (e) => { if (!worldDropdown.contains(e.target)) worldDropdown.classList.remove('show'); }, true);

    // NPC弹窗
    function showNpcModal(name) {
        const npc = getWorld().npcs[name]; if (!npc) return;
        const aff = npc.affection || 100;
        const unlocked = appState.privateUnlocked[getWorldKey()+'_'+name] || false;
        const pData = appState.privateData[getWorldKey()+'_'+name] || {};
        let html = `<button class="close-modal" id="closeNpc">✕</button><h3>${escapeHtml(name)}</h3>
        <div>❤️ ${aff}</div><div class="affection-bar"><div class="affection-fill" style="width:${Math.min(aff/2,100)}%;"></div></div>
        <div style="font-size:12px;color:var(--text2);margin:8px 0;">${escapeHtml(npc.description||'暂无描述')}</div>`;
        if (npc.status && Object.keys(npc.status).length) {
            html += '<div style="margin-top:10px;padding:8px;background:var(--surface2);border-radius:8px;"><b>📋 状态</b><br>';
            const labels = { gender:'性别', age:'年龄', emotion:'情绪', appearance:'外貌', breasts:'⚪️胸部', buttocks:'🍑臀部', clitoris:'💧阴蒂', feet:'👣脚', labia:'💋阴唇', vagina:'🌸阴道', uterus:'🤰子宫', pose:'🧘姿势' };
            for (const [k,v] of Object.entries(npc.status)) html += `<div>${labels[k]||k}: ${escapeHtml(String(v))}</div>`;
            html += '</div>';
        }
        if (aff >= 100) {
            if (unlocked) html += `<div style="margin-top:12px;"><b>🔓 私密档案</b><pre style="font-size:11px;">${escapeHtml(JSON.stringify(pData,null,2))}</pre><button class="btn-sm" id="editPrivate">✏️</button></div>`;
            else html += `<div style="margin-top:12px;text-align:center;"><button class="btn-sm btn-gold" id="unlockPrivate">🔓 解锁</button></div>`;
        }
        $('#npcModalCard').innerHTML = html;
        $('#npcModal').classList.add('show');
        $('#closeNpc').onclick = ()=> $('#npcModal').classList.remove('show');
        const unlockBtn = $('#unlockPrivate');
        if (unlockBtn) unlockBtn.onclick = ()=> showPrivatePwd(name);
        const editBtn = $('#editPrivate');
        if (editBtn) editBtn.onclick = ()=> showPrivateEditor(name);
    }
    function showPrivatePwd(name) {
        $('#privateModalCard').innerHTML = `<button class="close-modal" id="closePwd">✕</button><h3>密码</h3><input type="password" id="pwdInput" style="width:100%;padding:10px;margin:10px 0;background:var(--surface2);border:1px solid var(--border);color:var(--text);border-radius:8px;"><button class="btn-sm btn-gold" id="confirmPwd">确认</button>`;
        $('#privateModal').classList.add('show');
        $('#closePwd').onclick = ()=> $('#privateModal').classList.remove('show');
        $('#confirmPwd').onclick = ()=>{
            if ($('#pwdInput').value === PRIVATE_PASSWORD) {
                appState.privateUnlocked[getWorldKey()+'_'+name] = true;
                if (!appState.privateData[getWorldKey()+'_'+name]) appState.privateData[getWorldKey()+'_'+name] = {};
                saveState(); $('#privateModal').classList.remove('show'); $('#npcModal').classList.remove('show');
                showNpcModal(name); addSystemMsg(`🔓 ${name} 私密档案已解锁`);
            } else alert('密码错误');
        };
    }
    function showPrivateEditor(name) {
        const key = getWorldKey()+'_'+name;
        const data = appState.privateData[key] || {};
        $('#privateModalCard').innerHTML = `<button class="close-modal" id="closeEditor">✕</button><h3>编辑私密档案</h3><textarea id="editorTA" rows="10" style="width:100%;padding:10px;background:var(--surface2);border:1px solid var(--border);color:var(--text);border-radius:8px;">${escapeHtml(JSON.stringify(data,null,2))}</textarea><button class="btn-sm btn-gold" id="saveEditor" style="margin-top:8px;">保存</button>`;
        $('#privateModal').classList.add('show');
        $('#closeEditor').onclick = ()=> $('#privateModal').classList.remove('show');
        $('#saveEditor').onclick = ()=>{
            try {
                appState.privateData[key] = JSON.parse($('#editorTA').value);
                saveState(); $('#privateModal').classList.remove('show'); $('#npcModal').classList.remove('show');
                showNpcModal(name); addSystemMsg('✅ 私密档案已更新');
            } catch(e) { alert('JSON错误'); }
        };
    }

    // 生图
    function getLastAssistantContent() {
        const msgs = getWorld().messages;
        for (let i=msgs.length-1; i>=0; i--) {
            if (msgs[i].role==='assistant') {
                let t = msgs[i].content.replace(/```json[\s\S]*?```/g,'').trim();
                return t.length>200 ? t.substring(0,200) : t;
            }
        }
        return '';
    }
    $('#imgGenBtn').onclick = () => {
        const defPrompt = getLastAssistantContent();
        $('#imgGenModalCard').innerHTML = `<button class="close-modal" id="closeImg">✕</button><h3>🎨 生成图片</h3><textarea id="imgPrompt" rows="4" style="width:100%;padding:10px;background:var(--surface2);border:1px solid var(--border);color:var(--text);border-radius:8px;">${escapeHtml(defPrompt)}</textarea><button class="btn-sm btn-gold" id="startImg" style="margin-top:8px;width:100%;">生成</button><div id="imgStatus" style="font-size:11px;color:var(--text3);margin-top:6px;"></div>`;
        $('#imgGenModal').classList.add('show');
        $('#closeImg').onclick = ()=> $('#imgGenModal').classList.remove('show');
        $('#startImg').onclick = async () => {
            const prompt = $('#imgPrompt').value.trim(); if (!prompt) return;
            const btn = $('#startImg'); btn.disabled=true; btn.textContent='生成中...';
            $('#imgStatus').textContent = '等待生成...';
            try {
                const url = IMG_GEN_URL + encodeURIComponent(prompt);
                const img = new Image(); img.src = url;
                await new Promise((resolve, reject) => { img.onload=resolve; img.onerror=()=>reject(new Error('失败')); setTimeout(()=>reject(new Error('超时')), 30000); });
                getWorld().messages.push({role:'image', content:url, timestamp:Date.now()});
                appendMsg({role:'image', content:url}); saveState();
                $('#imgGenModal').classList.remove('show'); addSystemMsg('🎨 图片已生成');
            } catch(e) { $('#imgStatus').textContent = '❌ '+e.message; }
            finally { btn.disabled=false; btn.textContent='生成'; }
        };
    };

    // 对话
    msgInput.oninput = () => { msgInput.style.height='auto'; msgInput.style.height=Math.min(msgInput.scrollHeight,120)+'px'; };
    msgInput.onkeydown = (e) => { if (e.key==='Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); } };
    $('#sendBtn').onclick = sendMessage;

    async function sendMessage() {
        if (isStreaming) return;
        const text = msgInput.value.trim(); if (!text) return;
        if (!appState.settings.apiKey) { alert('请先设置API Key'); return; }
        const w = getWorld();
        w.messages.push({role:'user', content:text, timestamp:Date.now()});
        appendMsg({role:'user', content:text});
        msgInput.value=''; msgInput.style.height='auto';
        saveState();

        const systemPrompt = buildSystemPrompt();
        const messages = [
            {role:'system', content:systemPrompt},
            ...w.messages.filter(m=>m.role==='user'||m.role==='assistant').slice(-20).map(m=>({role:m.role,content:m.content}))
        ];

        const thinkingDiv = document.createElement('div');
        thinkingDiv.className='msg-bubble msg-assistant';
        thinkingDiv.innerHTML='<div class="thinking-dots"><span></span><span></span><span></span></div>思考中...';
        chatArea.appendChild(thinkingDiv); scrollBottom();

        isStreaming=true; $('#sendBtn').disabled=true;
        try {
            const resp = await fetch(API_URL, {
                method:'POST',
                headers:{'Content-Type':'application/json','Authorization':`Bearer ${appState.settings.apiKey}`},
                body: JSON.stringify({
                    model: appState.settings.model,
                    messages, stream:true,
                    max_tokens:2048, temperature:0.95,
                    ...(appState.settings.enableSearch?{enable_search:true}:{})
                }),
                signal: AbortSignal.timeout(120000)
            });
            if (!resp.ok) throw new Error('API错误 '+resp.status);
            thinkingDiv.remove();

            const assistantDiv = document.createElement('div');
            assistantDiv.className='msg-bubble msg-assistant';
            assistantDiv.innerHTML='<div class="msg-label">📖</div>';
            chatArea.appendChild(assistantDiv);
            let fullContent='';

            const reader = resp.body.getReader();
            const decoder = new TextDecoder();
            let buffer='';
            while(true) {
                const {done, value} = await reader.read();
                if (done) break;
                buffer += decoder.decode(value, {stream:true});
                const lines = buffer.split('\n');
                buffer = lines.pop() || '';
                for (const line of lines) {
                    if (!line.trim() || !line.startsWith('data:')) continue;
                    const str = line.slice(5).trim();
                    if (str==='[DONE]') continue;
                    try {
                        const delta = JSON.parse(str).choices?.[0]?.delta?.content || '';
                        fullContent += delta;
                        let display = fullContent.replace(/```json[\s\S]*?(```|$)/g,'').replace(/【[^】]*$/g,'');
                        assistantDiv.innerHTML = '<div class="msg-label">📖</div>'+escapeHtml(display).replace(/\n/g,'<br>');
                        scrollBottom();
                    } catch(e){}
                }
            }
            let finalDisplay = fullContent.replace(/```json[\s\S]*?```/g,'').replace(/【[^】]+】/g,'').trim();
            assistantDiv.innerHTML = '<div class="msg-label">📖</div>'+escapeHtml(finalDisplay).replace(/\n/g,'<br>');
            const suggests = fullContent.match(/【([^】]+)】/g);
            if (suggests) {
                const chipDiv = document.createElement('div'); chipDiv.className='suggest-chips';
                suggests.slice(0,4).forEach(s => {
                    const chip = document.createElement('span'); chip.className='suggest-chip';
                    chip.textContent = s.replace(/[【】]/g,''); chip.onclick = () => { msgInput.value = s.replace(/[【】]/g,''); msgInput.focus(); };
                    chipDiv.appendChild(chip);
                });
                assistantDiv.appendChild(chipDiv);
            }
            w.messages.push({role:'assistant', content:fullContent, timestamp:Date.now()});
            processJson(fullContent);
            saveState(); renderNpcStrip();
        } catch(err) {
            thinkingDiv.remove();
            const errDiv = document.createElement('div');
            errDiv.className='msg-system'; errDiv.textContent='⚠️ '+(err.name==='TimeoutError'?'超时':err.message);
            errDiv.style.color='var(--danger)'; chatArea.appendChild(errDiv);
        } finally {
            isStreaming=false; $('#sendBtn').disabled=false;
            scrollBottom(); msgInput.focus();
        }
    }

    function buildSystemPrompt() {
        const w = getWorld(); let p = w.prompt;
        const ps = appState.protagonistStatus;
        p += `\n【状态】${ps.name} | ${ps.location} | ${ps.time}`;
        const npcs = Object.keys(w.npcs);
        if (npcs.length) p += `\n已结识: ${npcs.map(n=>`${n}(好感${w.npcs[n].affection||100})`).join(', ')}`;
        if (currentTargetNpc) p += `\n当前目标: ${currentTargetNpc}`;
        return p;
    }

    function processJson(text) {
        const matches = text.match(/```json\s*([\s\S]*?)```/g);
        if (!matches) return;
        let lastValid = null;
        matches.forEach(m => {
            try { lastValid = JSON.parse(m.replace(/```json\s*|\s*```/g,'').trim()); } catch(e){}
        });
        if (!lastValid) return;
        const data = lastValid;
        const w = getWorld();
        let changed = false;
        if (data.npc_met && typeof data.npc_met==='string') {
            const name = data.npc_met.trim();
            if (!w.npcs[name]) {
                w.npcs[name] = { affection:100, description:data.npc_description||'', status:data.npc_status||{}, metAt:Date.now() };
                addSystemMsg(`✨ 结识 ${name}`); checkAchievement('初次邂逅'); changed=true;
            } else {
                if (data.npc_description) w.npcs[name].description = data.npc_description;
                if (data.npc_status) w.npcs[name].status = Object.assign(w.npcs[name].status||{}, data.npc_status);
                changed=true;
            }
        }
        if (typeof data.affection_change==='number') {
            const target = currentTargetNpc || Object.keys(w.npcs).pop();
            if (target && w.npcs[target]) {
                const old = w.npcs[target].affection||100;
                w.npcs[target].affection = old + data.affection_change;
                if (old<100 && w.npcs[target].affection>=100) checkAchievement('羁绊满溢');
                changed=true;
            }
        }
        if (data.event) {
            if (!appState.memories[getWorldKey()]) appState.memories[getWorldKey()]=[];
            appState.memories[getWorldKey()].push({event:data.event, timestamp:Date.now()});
            changed=true;
        }
        if (data.location) { appState.protagonistStatus.location = data.location; changed=true; }
        if (data.time) { appState.protagonistStatus.time = data.time; changed=true; }
        if (changed) { saveState(); renderNpcStrip(); }
    }

    function checkAchievement(name) {
        if (!appState.achievements.find(a=>a.name===name)) {
            appState.achievements.push({name, timestamp:Date.now()});
            addSystemMsg(`🏆 ${name}`); saveState();
        }
    }

    // 启动
    renderAll();
    if (getWorld().messages.length===0) addSystemMsg(`欢迎来到 ${getWorld().emoji} ${getWorld().name}`);
})();
</script>
</body>
</html>
