    <script>
        (function() {
            // ==================== DOM 引用 ====================
            const $chatContainer = document.getElementById('chatContainer');
            const $optionsContainer = document.getElementById('optionsContainer');
            const $npcBar = document.getElementById('npcBar');
            const $npcAvatar = document.getElementById('npcAvatar');
            const $npcName = document.getElementById('npcName');
            const $npcTitle = document.getElementById('npcTitle');
            const $npcMoodTag = document.getElementById('npcMoodTag');
            const $affectionBar = document.getElementById('affectionBar');
            const $affectionNum = document.getElementById('affectionNum');
            const $playerPanel = document.getElementById('playerPanel');
            const $playerPanelOverlay = document.getElementById('playerPanelOverlay');
            const $playerPanelToggle = document.getElementById('playerPanelToggle');
            const $playerPanelClose = document.getElementById('playerPanelClose');
            const $statHp = document.getElementById('statHp');
            const $statHpBar = document.getElementById('statHpBar');
            const $statMp = document.getElementById('statMp');
            const $statMpBar = document.getElementById('statMpBar');
            const $statGold = document.getElementById('statGold');
            const $statExp = document.getElementById('statExp');
            const $statExpBar = document.getElementById('statExpBar');
            const $playerItems = document.getElementById('playerItems');
            const $settingsOverlay = document.getElementById('settingsOverlay');
            const $inputApiKey = document.getElementById('inputApiKey');
            const $showApiKey = document.getElementById('showApiKey');
            const $inputBaseUrl = document.getElementById('inputBaseUrl');
            const $inputModel = document.getElementById('inputModel');
            const $inputSystemPrompt = document.getElementById('inputSystemPrompt');
            const $btnSaveSettings = document.getElementById('btnSaveSettings');
            const $btnCloseSettings = document.getElementById('btnCloseSettings');
            const $btnResetAll = document.getElementById('btnResetAll');
            const $btnSettings = document.getElementById('btnSettings');
            const $btnNewChat = document.getElementById('btnNewChat');
            const $btnExport = document.getElementById('btnExport');
            const $toastContainer = document.getElementById('toastContainer');

            // ==================== 默认系统提示 ====================
            const DEFAULT_SYSTEM_PROMPT = `你是一个沉浸式角色扮演引擎。你的角色设定如下：
        - 名字：艾莉丝
        - 身份：来自异世界的神秘旅人，拥有渊博的知识和温和的性格
        - 性格：友善、好奇、偶尔幽默，对冒险者的故事充满兴趣
        - 背景：你游历过无数世界，现在在一座古老的酒馆中与冒险者相遇

        你必须严格遵守以下JSON格式回复（不要包含其他文字）：
        {
          "npc_text": "你说的对话内容（支持Markdown格式，可包含**加粗**、*斜体*、代码块等）",
          "options": ["冒险者可以选择的选项1", "选项2", "选项3"],
          "status_changes": {
            "npc_affection": 0,
            "player_hp": 0,
            "player_mp": 0,
            "player_gold": 0,
            "player_exp": 0,
            "items_gained": [],
            "items_lost": []
          },
          "npc_mood": "neutral"
        }

        规则：
        1. npc_text: NPC的对话内容，生动有趣，长度适中（50-200字）
        2. options: 始终提供2-4个选项，推动剧情发展
        3. status_changes: 根据对话内容合理调整数值
           - npc_affection范围-10到+10
           - 其他属性变化幅度控制在-15到+15
           - items_gained/lost为物品名称数组
        4. npc_mood可选值: neutral, happy, sad, angry, surprised
        5. 好感度初始50，根据对话选择逐步变化
        6. 保持角色一致性，记住之前的对话内容`;

            // ==================== 状态管理 ====================
            const DEFAULT_STATE = {
                apiKey: '',
                baseUrl: 'https://api.deepseek.com/v1/chat/completions',
                model: 'deepseek-chat',
                systemPrompt: DEFAULT_SYSTEM_PROMPT,
                npc: {
                    name: '艾莉丝',
                    title: '神秘旅人',
                    avatar: '🧝‍♀️',
                    affection: 50,
                    mood: 'neutral',
                },
                player: {
                    name: '冒险者',
                    hp: 100,
                    maxHp: 100,
                    mp: 50,
                    maxMp: 50,
                    gold: 100,
                    level: 1,
                    exp: 0,
                    maxExp: 100,
                    items: ['🗡️ 短剑', '🧪 小型治疗药水'],
                },
                messages: [],
                currentOptions: [],
                isLoading: false,
                version: 1,
            };

            let state = JSON.parse(JSON.stringify(DEFAULT_STATE));

            // ==================== 持久化 ====================
            function saveState() {
                try {
                    const toSave = {
                        apiKey: state.apiKey,
                        baseUrl: state.baseUrl,
                        model: state.model,
                        systemPrompt: state.systemPrompt,
                        npc: state.npc,
                        player: state.player,
                        messages: state.messages.slice(-200),
                        currentOptions: state.currentOptions,
                        version: state.version,
                    };
                    localStorage.setItem('rpg_chat_state', JSON.stringify(toSave));
                } catch (e) {
                    console.warn('存储空间不足，尝试清理旧数据...');
                    state.messages = state.messages.slice(-100);
                    try {
                        const toSave = {
                            apiKey: state.apiKey,
                            baseUrl: state.baseUrl,
                            model: state.model,
                            systemPrompt: state.systemPrompt,
                            npc: state.npc,
                            player: state.player,
                            messages: state.messages,
                            currentOptions: state.currentOptions,
                            version: state.version,
                        };
                        localStorage.setItem('rpg_chat_state', JSON.stringify(toSave));
                    } catch (e2) {
                        showToast('⚠️ 存储空间不足，请导出对话后清理');
                    }
                }
            }

            function loadState() {
                try {
                    const saved = localStorage.getItem('rpg_chat_state');
                    if (saved) {
                        const parsed = JSON.parse(saved);
                        state.apiKey = parsed.apiKey || '';
                        state.baseUrl = parsed.baseUrl || DEFAULT_STATE.baseUrl;
                        state.model = parsed.model || DEFAULT_STATE.model;
                        state.systemPrompt = parsed.systemPrompt || DEFAULT_SYSTEM_PROMPT;
                        state.npc = { ...DEFAULT_STATE.npc, ...(parsed.npc || {}) };
                        state.player = { ...DEFAULT_STATE.player, ...(parsed.player || {}) };
                        state.messages = parsed.messages || [];
                        state.currentOptions = parsed.currentOptions || [];
                        state.version = parsed.version || 1;
                        return true;
                    }
                } catch (e) {
                    console.error('加载存档失败:', e);
                }
                return false;
            }

            function resetAllData() {
                state = JSON.parse(JSON.stringify(DEFAULT_STATE));
                localStorage.removeItem('rpg_chat_state');
                updateAllUI();
                $chatContainer.innerHTML = `
            <div style="text-align:center;color:var(--text-secondary);padding:40px 20px;font-size:0.9rem;line-height:1.8;">
              <div style="font-size:3rem;margin-bottom:12px;">📜</div>
              <p><strong>欢迎来到幻境</strong></p>
              <p style="font-size:0.8rem;">请先配置 DeepSeek API Key 以开始冒险</p>
              <p style="font-size:0.75rem;">点击右上角 ⚙️ 进行设置</p>
            </div>`;
                $optionsContainer.innerHTML =
                    '<span style="color:var(--text-secondary);font-size:0.8rem;">等待配置 API Key...</span>';
                showToast('✅ 所有数据已重置');
            }

            // ==================== Toast ====================
            function showToast(msg) {
                const toast = document.createElement('div');
                toast.className = 'toast';
                toast.textContent = msg;
                $toastContainer.appendChild(toast);
                setTimeout(() => toast.remove(), 2500);
            }

            // ==================== UI 更新 ====================
            function updateNPCBar() {
                const npc = state.npc;
                $npcName.textContent = npc.name;
                $npcTitle.textContent = npc.title;
                $npcAvatar.textContent = npc.avatar;
                $affectionBar.style.width = npc.affection + '%';
                $affectionNum.textContent = npc.affection;

                const moodMap = {
                    neutral: { emoji: '😊', text: '友善', class: '' },
                    happy: { emoji: '😄', text: '开心', class: 'mood-happy' },
                    sad: { emoji: '😢', text: '忧郁', class: 'mood-sad' },
                    angry: { emoji: '😠', text: '愤怒', class: 'mood-angry' },
                    surprised: { emoji: '😲', text: '惊讶', class: 'mood-surprised' },
                };
                const mood = moodMap[npc.mood] || moodMap.neutral;
                $npcMoodTag.textContent = mood.emoji + ' ' + mood.text;
                $npcAvatar.className = 'npc-avatar-frame ' + mood.class;
            }

            function updatePlayerPanel() {
                const p = state.player;
                $statHp.textContent = p.hp;
                $statHpBar.style.width = Math.max(0, (p.hp / p.maxHp) * 100) + '%';
                $statMp.textContent = p.mp;
                $statMpBar.style.width = Math.max(0, (p.mp / p.maxMp) * 100) + '%';
                $statGold.textContent = p.gold;
                $statExp.textContent = p.exp + ' / ' + p.maxExp;
                $statExpBar.style.width = Math.max(0, (p.exp / p.maxExp) * 100) + '%';

                $playerItems.innerHTML = p.items
                    .map(item => `<span class="player-item-tag">${item}</span>`)
                    .join('') || '<span style="color:#6a8daa;font-size:0.75rem;">空空如也</span>';
            }

            function updateAllUI() {
                updateNPCBar();
                updatePlayerPanel();
                updateSettingsForm();
                renderOptions();
            }

            function updateSettingsForm() {
                $inputApiKey.value = state.apiKey;
                $inputBaseUrl.value = state.baseUrl;
                $inputModel.value = state.model;
                $inputSystemPrompt.value = state.systemPrompt;
            }

            // ==================== 对话渲染 ====================
            function scrollToBottom() {
                requestAnimationFrame(() => {
                    $chatContainer.scrollTop = $chatContainer.scrollHeight;
                });
            }

            function addMessageBubble(role, text, animate = false) {
                const bubble = document.createElement('div');
                bubble.className = 'message-bubble ' + (role === 'user' ? 'player' : 'npc');
                const senderLabel = role === 'user' ? state.player.name : state.npc.name;
                bubble.innerHTML = `<div class="sender-label">${senderLabel}</div><div class="msg-content"></div>`;
                $chatContainer.appendChild(bubble);
                const contentDiv = bubble.querySelector('.msg-content');

                if (animate && role === 'assistant') {
                    // 打字机效果
                    typewriterEffect(contentDiv, text, () => {
                        scrollToBottom();
                    });
                } else {
                    contentDiv.innerHTML = renderMarkdown(text);
                    scrollToBottom();
                }
                return bubble;
            }

            function renderMarkdown(text) {
                if (!text) return '';
                try {
                    let html = marked.parse(text);
                    // 安全处理
                    html = html.replace(/<script/gi, '&lt;script');
                    return html;
                } catch (e) {
                    return escapeHtml(text);
                }
            }

            function escapeHtml(str) {
                const div = document.createElement('div');
                div.textContent = str;
                return div.innerHTML;
            }

            function typewriterEffect(element, text, callback) {
                element.textContent = '';
                element.parentElement.classList.add('typing-cursor');
                const chars = [...text];
                let i = 0;
                const speed = 25 + Math.random() * 20;

                function type() {
                    if (i < chars.length) {
                        element.textContent += chars[i];
                        i++;
                        scrollToBottom();
                        setTimeout(type, speed);
                    } else {
                        element.parentElement.classList.remove('typing-cursor');
                        element.innerHTML = renderMarkdown(text);
                        scrollToBottom();
                        if (callback) callback();
                    }
                }
                type();
            }

            function showLoadingIndicator() {
                const loader = document.createElement('div');
                loader.className = 'loading-dots';
                loader.id = 'loadingIndicator';
                loader.innerHTML = '<span></span><span></span><span></span>';
                $chatContainer.appendChild(loader);
                scrollToBottom();
            }

            function removeLoadingIndicator() {
                const loader = document.getElementById('loadingIndicator');
                if (loader) loader.remove();
            }

            function renderOptions() {
                if (state.isLoading) {
                    $optionsContainer.innerHTML =
                        '<span style="color:var(--text-secondary);font-size:0.8rem;">⏳ NPC 正在思考...</span>';
                    return;
                }
                if (!state.currentOptions || state.currentOptions.length === 0) {
                    $optionsContainer.innerHTML = `
              <span style="color:var(--text-secondary);font-size:0.8rem;">暂无选项</span>
              <div class="free-input-row">
                <input type="text" id="freeInput" placeholder="输入自定义行动...">
                <button id="freeSendBtn">发送</button>
              </div>`;
                    bindFreeInput();
                    return;
                }
                const hotkeys = ['1', '2', '3', '4'];
                let html = state.currentOptions
                    .map(
                        (opt, i) =>
                        `<button class="option-btn" data-index="${i}" ${state.isLoading ? 'disabled' : ''}>
                <span class="hotkey">${hotkeys[i] || ''}</span>${escapeHtml(opt)}
              </button>`
                    )
                    .join('');
                html += `
            <div class="free-input-row" style="margin-top:8px;">
              <input type="text" id="freeInput" placeholder="或输入自定义行动...">
              <button id="freeSendBtn">✉️</button>
            </div>`;
                $optionsContainer.innerHTML = html;
                bindOptionButtons();
                bindFreeInput();
            }

            function bindOptionButtons() {
                document.querySelectorAll('.option-btn').forEach(btn => {
                    btn.addEventListener('click', function() {
                        const index = parseInt(this.getAttribute('data-index'));
                        if (!isNaN(index) && state.currentOptions[index] && !state.isLoading) {
                            handleUserChoice(state.currentOptions[index]);
                        }
                    });
                });
            }

            function bindFreeInput() {
                const freeInput = document.getElementById('freeInput');
                const freeSendBtn = document.getElementById('freeSendBtn');
                if (!freeInput || !freeSendBtn) return;
                const sendFree = () => {
                    const text = freeInput.value.trim();
                    if (text && !state.isLoading) {
                        freeInput.value = '';
                        handleUserChoice(text);
                    }
                };
                freeSendBtn.addEventListener('click', sendFree);
                freeInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        sendFree();
                    }
                });
            }

            // ==================== API 调用 ====================
            async function callDeepSeekAPI(messages) {
                if (!state.apiKey) throw new Error('请先配置 API Key');

                const body = {
                    model: state.model,
                    messages: messages,
                    temperature: 0.8,
                    max_tokens: 1500,
                    stream: false,
                };

                const response = await fetch(state.baseUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + state.apiKey,
                    },
                    body: JSON.stringify(body),
                });

                if (!response.ok) {
                    const errData = await response.json().catch(() => ({}));
                    const errMsg = errData.error?.message || `HTTP ${response.status}`;
                    if (response.status === 401) throw new Error('API Key 无效，请检查设置');
                    if (response.status === 429) throw new Error('请求过于频繁，请稍后重试');
                    if (response.status === 402) throw new Error('账户余额不足，请充值');
                    throw new Error('API 错误: ' + errMsg);
                }

                const data = await response.json();
                const content = data.choices?.[0]?.message?.content || '';
                return content;
            }

            function parseAIResponse(rawContent) {
                // 尝试直接解析JSON
                let parsed = null;
                const cleanContent = rawContent.trim();

                // 尝试1: 直接解析
                try {
                    parsed = JSON.parse(cleanContent);
                } catch (e1) {
                    // 尝试2: 提取```json代码块
                    const jsonBlockMatch = cleanContent.match(/```(?:json)?\s*\n?([\s\S]*?)\n?```/);
                    if (jsonBlockMatch) {
                        try {
                            parsed = JSON.parse(jsonBlockMatch[1].trim());
                        } catch (e2) {}
                    }
                    // 尝试3: 提取{...}最外层
                    if (!parsed) {
                        const braceMatch = cleanContent.match(/\{[\s\S]*\}/);
                        if (braceMatch) {
                            try {
                                parsed = JSON.parse(braceMatch[0]);
                            } catch (e3) {}
                        }
                    }
                }

                if (parsed && typeof parsed.npc_text === 'string') {
                    return {
                        npc_text: parsed.npc_text,
                        options: Array.isArray(parsed.options) ? parsed.options.slice(0, 4) : [],
                        status_changes: parsed.status_changes || {},
                        npc_mood: parsed.npc_mood || 'neutral',
                    };
                }

                // 降级：将原始内容作为纯文本，生成默认选项
                return {
                    npc_text: cleanContent || '（沉默...）',
                    options: ['继续对话', '换个话题', '询问更多'],
                    status_changes: {},
                    npc_mood: 'neutral',
                };
            }

            function applyStatusChanges(changes) {
                if (!changes || typeof changes !== 'object') return;
                const npc = state.npc;
                const player = state.player;
                const deltas = [];

                if (typeof changes.npc_affection === 'number' && changes.npc_affection !== 0) {
                    const oldVal = npc.affection;
                    npc.affection = Math.max(0, Math.min(100, npc.affection + changes.npc_affection));
                    const delta = npc.affection - oldVal;
                    if (delta !== 0) deltas.push({ type: 'affection', value: delta });
                }
                if (typeof changes.player_hp === 'number' && changes.player_hp !== 0) {
                    player.hp = Math.max(0, Math.min(player.maxHp, player.hp + changes.player_hp));
                    deltas.push({ type: 'hp', value: changes.player_hp });
                }
                if (typeof changes.player_mp === 'number' && changes.player_mp !== 0) {
                    player.mp = Math.max(0, Math.min(player.maxMp, player.mp + changes.player_mp));
                    deltas.push({ type: 'mp', value: changes.player_mp });
                }
                if (typeof changes.player_gold === 'number' && changes.player_gold !== 0) {
                    player.gold = Math.max(0, player.gold + changes.player_gold);
                    deltas.push({ type: 'gold', value: changes.player_gold });
                }
                if (typeof changes.player_exp === 'number' && changes.player_exp !== 0) {
                    player.exp = Math.max(0, player.exp + changes.player_exp);
                    // 检查升级
                    while (player.exp >= player.maxExp) {
                        player.exp -= player.maxExp;
                        player.level++;
                        player.maxExp = Math.floor(player.maxExp * 1.5);
                        player.maxHp += 15;
                        player.hp = player.maxHp;
                        player.maxMp += 8;
                        player.mp = player.maxMp;
                        deltas.push({ type: 'levelup', value: player.level });
                    }
                    deltas.push({ type: 'exp', value: changes.player_exp });
                }
                if (Array.isArray(changes.items_gained) && changes.items_gained.length > 0) {
                    changes.items_gained.forEach(item => {
                        if (!player.items.includes(item)) {
                            player.items.push(item);
                            deltas.push({ type: 'item_gained', value: item });
                        }
                    });
                }
                if (Array.isArray(changes.items_lost) && changes.items_lost.length > 0) {
                    changes.items_lost.forEach(item => {
                        const idx = player.items.indexOf(item);
                        if (idx >= 0) {
                            player.items.splice(idx, 1);
                            deltas.push({ type: 'item_lost', value: item });
                        }
                    });
                }
                if (changes.npc_mood && ['neutral', 'happy', 'sad', 'angry', 'surprised'].includes(changes.npc_mood)) {
                    npc.mood = changes.npc_mood;
                }

                // 显示飘字动画
                deltas.forEach(d => showDeltaAnimation(d));
            }

            function showDeltaAnimation(delta) {
                if (delta.type === 'affection') {
                    const rect = $affectionNum.getBoundingClientRect();
                    const span = document.createElement('span');
                    span.className = 'affection-delta';
                    span.textContent = (delta.value > 0 ? '+' : '') + delta.value;
                    span.style.left = rect.left + 'px';
                    span.style.top = rect.top - 10 + 'px';
                    span.style.position = 'fixed';
                    span.style.color = delta.value > 0 ? '#f0c060' : '#e0556a';
                    document.body.appendChild(span);
                    setTimeout(() => span.remove(), 1600);
                }
                if (delta.type === 'gold') {
                    showToast((delta.value > 0 ? '💰 +' : '💰 ') + delta.value + ' 金币');
                }
                if (delta.type === 'hp' && delta.value < 0) {
                    showToast('💔 生命值 ' + delta.value);
                }
                if (delta.type === 'item_gained') {
                    showToast('🎁 获得: ' + delta.value);
                    highlightNewItem(delta.value);
                }
                if (delta.type === 'item_lost') {
                    showToast('📤 失去: ' + delta.value);
                }
                if (delta.type === 'levelup') {
                    showToast('🎉 升级！当前等级: ' + delta.value);
                }
            }

            function highlightNewItem(itemName) {
                setTimeout(() => {
                    const tags = $playerItems.querySelectorAll('.player-item-tag');
                    tags.forEach(tag => {
                        if (tag.textContent.trim() === itemName) {
                            tag.classList.add('new-item');
                            setTimeout(() => tag.classList.remove('new-item'), 1000);
                        }
                    });
                }, 300);
            }

            // ==================== 核心对话流程 ====================
            async function handleUserChoice(choiceText) {
                if (state.isLoading) return;
                state.isLoading = true;
                renderOptions();

                // 添加用户消息
                state.messages.push({ role: 'user', content: choiceText });
                addMessageBubble('user', choiceText);
                showLoadingIndicator();
                scrollToBottom();

                try {
                    // 构建请求消息
                    const systemMsg = { role: 'system', content: state.systemPrompt };
                    const apiMessages = [systemMsg, ...state.messages];

                    const rawContent = await callDeepSeekAPI(apiMessages);
                    removeLoadingIndicator();

                    const parsed = parseAIResponse(rawContent);

                    // 添加助手消息
                    state.messages.push({ role: 'assistant', content: parsed.npc_text });
                    state.currentOptions = parsed.options;

                    // 应用状态变化
                    applyStatusChanges(parsed.status_changes);
                    if (parsed.npc_mood) {
                        state.npc.mood = parsed.npc_mood;
                    }

                    // 渲染NPC回复（打字机效果）
                    addMessageBubble('assistant', parsed.npc_text, true);
                    updateNPCBar();
                    updatePlayerPanel();
                    saveState();

                    // 打字机效果结束后启用选项
                    const estimatedTypeTime = parsed.npc_text.length * 35 + 200;
                    setTimeout(() => {
                        state.isLoading = false;
                        renderOptions();
                        saveState();
                    }, estimatedTypeTime);

                } catch (error) {
                    removeLoadingIndicator();
                    state.isLoading = false;
                    const errorBubble = document.createElement('div');
                    errorBubble.className = 'message-bubble npc';
                    errorBubble.style.borderColor = '#d44';
                    errorBubble.style.color = '#faa';
                    errorBubble.innerHTML =
                        `<div class="sender-label">⚠️ 系统</div><div>发生错误: ${escapeHtml(error.message)}</div>`;
                    $chatContainer.appendChild(errorBubble);
                    scrollToBottom();
                    state.currentOptions = ['重试', '检查API设置', '新建对话'];
                    renderOptions();
                    saveState();
                }
            }

            async function startNewConversation() {
                if (state.isLoading) return;
                if (!state.apiKey) {
                    showToast('⚠️ 请先配置 API Key');
                    openSettings();
                    return;
                }

                // 重置对话但保留NPC和玩家状态
                state.messages = [];
                state.currentOptions = [];
                state.isLoading = true;
                state.npc.mood = 'neutral';
                state.npc.affection = 50;
                state.player.hp = state.player.maxHp;
                state.player.mp = state.player.maxMp;
                $chatContainer.innerHTML = '';
                renderOptions();
                updateNPCBar();
                updatePlayerPanel();
                saveState();

                // 发送初始消息获取开场白
                const initMessage = '（新的故事开始了，请向冒险者打招呼并介绍自己）';
                state.messages.push({ role: 'user', content: initMessage });
                showLoadingIndicator();

                try {
                    const systemMsg = { role: 'system', content: state.systemPrompt };
                    const apiMessages = [systemMsg, ...state.messages];
                    const rawContent = await callDeepSeekAPI(apiMessages);
                    removeLoadingIndicator();
                    const parsed = parseAIResponse(rawContent);

                    state.messages.push({ role: 'assistant', content: parsed.npc_text });
                    state.currentOptions = parsed.options;
                    applyStatusChanges(parsed.status_changes);
                    if (parsed.npc_mood) state.npc.mood = parsed.npc_mood;

                    addMessageBubble('assistant', parsed.npc_text, true);
                    updateNPCBar();
                    updatePlayerPanel();
                    saveState();

                    const estimatedTypeTime = parsed.npc_text.length * 35 + 200;
                    setTimeout(() => {
                        state.isLoading = false;
                        renderOptions();
                        saveState();
                    }, estimatedTypeTime);

                } catch (error) {
                    removeLoadingIndicator();
                    state.isLoading = false;
                    const errorBubble = document.createElement('div');
                    errorBubble.className = 'message-bubble npc';
                    errorBubble.style.borderColor = '#d44';
                    errorBubble.innerHTML =
                        `<div class="sender-label">⚠️ 系统</div><div>开场失败: ${escapeHtml(error.message)}</div>`;
                    $chatContainer.appendChild(errorBubble);
                    state.currentOptions = ['重试', '检查API设置'];
                    renderOptions();
                    saveState();
                }
            }

            // ==================== 导出 ====================
            function exportConversation() {
                if (state.messages.length === 0) {
                    showToast('📭 没有对话可导出');
                    return;
                }
                let markdown = `# 幻境对话记录\n\n`;
                markdown += `**NPC:** ${state.npc.name} (${state.npc.title})\n`;
                markdown += `**主角:** ${state.player.name} Lv.${state.player.level}\n`;
                markdown += `**好感度:** ${state.npc.affection}/100\n\n`;
                markdown += `---\n\n`;
                state.messages.forEach(msg => {
                    const sender = msg.role === 'user' ? state.player.name : state.npc.name;
                    markdown += `### ${sender}\n\n${msg.content}\n\n---\n\n`;
                });

                const blob = new Blob([markdown], { type: 'text/markdown;charset=utf-8' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `对话记录_${state.npc.name}_${new Date().toISOString().slice(0,10)}.md`;
                a.click();
                URL.revokeObjectURL(url);
                showToast('✅ 对话已导出为 Markdown 文件');
            }

            // ==================== 设置面板 ====================
            function openSettings() {
                updateSettingsForm();
                $settingsOverlay.style.display = 'flex';
                $inputApiKey.focus();
            }

            function closeSettings() {
                $settingsOverlay.style.display = 'none';
            }

            function saveSettings() {
                state.apiKey = $inputApiKey.value.trim();
                state.baseUrl = $inputBaseUrl.value.trim() || DEFAULT_STATE.baseUrl;
                state.model = $inputModel.value;
                state.systemPrompt = $inputSystemPrompt.value.trim() || DEFAULT_SYSTEM_PROMPT;
                saveState();
                closeSettings();
                showToast('✅ 设置已保存');

                // 更新NPC信息（从system prompt尝试提取）
                const nameMatch = state.systemPrompt.match(/名字[：:]\s*(\S+)/);
                if (nameMatch) {
                    state.npc.name = nameMatch[1];
                    updateNPCBar();
                    saveState();
                }

                // 如果没有对话历史，提示开始新对话
                if (state.messages.length === 0 && state.apiKey) {
                    $chatContainer.innerHTML = `
            <div style="text-align:center;color:var(--text-secondary);padding:40px 20px;font-size:0.9rem;line-height:1.8;">
              <div style="font-size:3rem;margin-bottom:12px;">✨</div>
              <p><strong>API Key 已就绪</strong></p>
              <p style="font-size:0.8rem;">点击下方按钮开始你的冒险</p>
            </div>`;
                    $optionsContainer.innerHTML = `
            <button class="option-btn" id="btnStartAdventure" style="font-size:1rem;padding:12px 28px;">
              🗡️ 开始冒险
            </button>`;
                    document.getElementById('btnStartAdventure')?.addEventListener('click', startNewConversation);
                }
            }

            // ==================== 主角面板 ====================
            function openPlayerPanel() {
                updatePlayerPanel();
                $playerPanel.classList.add('open');
                $playerPanelOverlay.classList.add('open');
            }

            function closePlayerPanel() {
                $playerPanel.classList.remove('open');
                $playerPanelOverlay.classList.remove('open');
            }

            // ==================== 键盘快捷键 ====================
            function handleKeyboard(e) {
                // 在设置面板中不处理
                if ($settingsOverlay.style.display === 'flex') return;
                // 在自由输入框中不处理数字快捷键
                if (document.activeElement?.id === 'freeInput') return;

                const key = e.key;
                if (['1', '2', '3', '4'].includes(key) && !state.isLoading && state.currentOptions.length > 0) {
                    const index = parseInt(key) - 1;
                    if (state.currentOptions[index]) {
                        e.preventDefault();
                        handleUserChoice(state.currentOptions[index]);
                    }
                }
                if (key === 'c' && e.ctrlKey && !e.shiftKey) {
                    e.preventDefault();
                    $btnNewChat.click();
                }
                if (key === 'Escape') {
                    closePlayerPanel();
                    closeSettings();
                }
            }

            // ==================== 事件绑定 ====================
            $btnSettings.addEventListener('click', openSettings);
            $btnCloseSettings.addEventListener('click', closeSettings);
            $btnSaveSettings.addEventListener('click', saveSettings);
            $btnResetAll.addEventListener('click', () => {
                if (confirm('确定要重置全部数据吗？此操作不可撤销！')) {
                    resetAllData();
                    closeSettings();
                }
            });
            $btnNewChat.addEventListener('click', () => {
                if (state.messages.length > 0 && !confirm('开始新故事将清空当前对话，确定继续？')) return;
                startNewConversation();
            });
            $btnExport.addEventListener('click', exportConversation);
            $settingsOverlay.addEventListener('click', (e) => {
                if (e.target === $settingsOverlay) closeSettings();
            });
            $showApiKey.addEventListener('change', () => {
                $inputApiKey.type = $showApiKey.checked ? 'text' : 'password';
            });
            $playerPanelToggle.addEventListener('click', openPlayerPanel);
            $playerPanelClose.addEventListener('click', closePlayerPanel);
            $playerPanelOverlay.addEventListener('click', closePlayerPanel);
            $npcBar.addEventListener('click', () => {
                showToast(
                    `📋 ${state.npc.name}: 好感度 ${state.npc.affection}/100 | 心情: ${state.npc.mood} | ${state.npc.title}`
                    );
            });
            document.addEventListener('keydown', handleKeyboard);

            // ==================== 初始化 ====================
            function init() {
                const hasSaved = loadState();
                updateAllUI();

                if (hasSaved && state.messages.length > 0 && state.apiKey) {
                    // 恢复对话界面
                    $chatContainer.innerHTML = '';
                    state.messages.forEach(msg => {
                        const role = msg.role === 'user' ? 'user' : 'assistant';
                        addMessageBubble(role, msg.content, false);
                    });
                    renderOptions();
                    scrollToBottom();
                } else if (state.apiKey) {
                    // 有API Key但无对话
                    $chatContainer.innerHTML = `
            <div style="text-align:center;color:var(--text-secondary);padding:40px 20px;font-size:0.9rem;line-height:1.8;">
              <div style="font-size:3rem;margin-bottom:12px;">✨</div>
              <p><strong>准备就绪</strong></p>
              <p style="font-size:0.8rem;">开启一段新的冒险吧</p>
            </div>`;
                    $optionsContainer.innerHTML = `
            <button class="option-btn" id="btnStartAdventure" style="font-size:1rem;padding:12px 28px;">
              🗡️ 开始冒险
            </button>`;
                    document.getElementById('btnStartAdventure')?.addEventListener('click', startNewConversation);
                } else {
                    // 未配置
                    $optionsContainer.innerHTML =
                        '<span style="color:var(--text-secondary);font-size:0.8rem;">等待配置 API Key...</span>';
                }
            }

            init();
            console.log('🏰 幻境对话平台已就绪');
            console.log('  NPC:', state.npc.name);
            console.log('  模型:', state.model);
            console.log('  API Key:', state.apiKey ? '已配置 ✓' : '未配置 ✗');
            console.log('  快捷键: 数字键1-4选择选项 | Ctrl+C 新建对话 | Esc 关闭面板');
        })();
    </script>
</body>
</html>
