<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>幻境对话 - AI角色扮演</title>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js">
    </script>
    <style>
        :root {
            --bg: #1a1a2e;
            --bg-secondary: #16213e;
            --bg-tertiary: #0f3460;
            --text: #e0d8c8;
            --text-secondary: #b0a890;
            --accent: #d4a853;
            --accent-glow: #f0c060;
            --npc-bubble: #2d1f3d;
            --player-bubble: #1a2740;
            --npc-bar-bg: #1f1528;
            --player-bar-bg: #0f1d2d;
            --hp-color: #e0556a;
            --mp-color: #5b9bd5;
            --gold-color: #e2b04a;
            --exp-color: #7bc67e;
            --danger: #d44;
            --success: #5b9;
            --border: #3a3040;
            --shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
            --radius: 12px;
            --radius-sm: 8px;
            --transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            --font-mono: 'SF Mono', 'Cascadia Code', 'Consolas', monospace;
            --font-ui: 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: var(--font-ui);
            background: var(--bg);
            color: var(--text);
            height: 100vh;
            height: 100dvh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
            background-image:
                radial-gradient(ellipse at 50% 0%, rgba(212, 168, 83, 0.06) 0%, transparent 60%),
                radial-gradient(ellipse at 80% 100%, rgba(100, 140, 200, 0.04) 0%, transparent 50%);
        }

        /* ============ 顶部栏 ============ */
        .top-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 14px;
            background: var(--bg-secondary);
            border-bottom: 1px solid var(--border);
            gap: 10px;
            z-index: 100;
            flex-shrink: 0;
            min-height: 52px;
        }
        .top-bar-left {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 700;
            font-size: 0.95rem;
            color: var(--accent);
            letter-spacing: 0.5px;
        }
        .top-bar-left .logo-icon {
            font-size: 1.4rem;
        }
        .top-bar-actions {
            display: flex;
            gap: 6px;
            flex-shrink: 0;
        }
        .btn-icon {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 1px solid var(--border);
            background: var(--bg-tertiary);
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
            position: relative;
        }
        .btn-icon:hover {
            background: var(--accent);
            color: #1a1a2e;
            border-color: var(--accent);
            box-shadow: 0 0 16px rgba(212, 168, 83, 0.3);
        }
        .btn-icon:active {
            transform: scale(0.92);
            transition: 0.1s;
        }
        .btn-icon .tooltip {
            position: absolute;
            bottom: -30px;
            left: 50%;
            transform: translateX(-50%);
            background: #000;
            color: #fff;
            font-size: 0.7rem;
            padding: 3px 8px;
            border-radius: 4px;
            white-space: nowrap;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.2s;
            z-index: 10;
        }
        .btn-icon:hover .tooltip {
            opacity: 1;
        }

        /* ============ NPC 状态栏 ============ */
        .npc-bar {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            background: var(--npc-bar-bg);
            border-bottom: 2px solid #3a2848;
            flex-shrink: 0;
            position: relative;
            overflow: visible;
            cursor: pointer;
            transition: var(--transition);
        }
        .npc-bar:hover {
            background: #261d30;
        }
        .npc-avatar-frame {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            border: 3px solid var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            background: #2a1f35;
            flex-shrink: 0;
            position: relative;
            box-shadow: 0 0 20px rgba(212, 168, 83, 0.25);
            transition: var(--transition);
        }
        .npc-avatar-frame.mood-happy {
            border-color: #7bc67e;
            box-shadow: 0 0 20px rgba(123, 198, 126, 0.35);
        }
        .npc-avatar-frame.mood-sad {
            border-color: #5b7fb0;
            box-shadow: 0 0 20px rgba(91, 127, 176, 0.3);
        }
        .npc-avatar-frame.mood-angry {
            border-color: #e0556a;
            box-shadow: 0 0 20px rgba(224, 85, 106, 0.4);
            animation: pulse-angry 0.6s ease-in-out infinite;
        }
        .npc-avatar-frame.mood-surprised {
            border-color: #e2b04a;
            box-shadow: 0 0 24px rgba(226, 176, 74, 0.45);
        }
        @keyframes pulse-angry {
            0%,
            100% {
                box-shadow: 0 0 20px rgba(224, 85, 106, 0.4);
            }
            50% {
                box-shadow: 0 0 35px rgba(224, 85, 106, 0.7);
            }
        }
        .npc-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
            min-width: 0;
            flex: 1;
        }
        .npc-name-row {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .npc-name {
            font-weight: 700;
            font-size: 1rem;
            color: #e8d8f0;
        }
        .npc-title {
            font-size: 0.75rem;
            color: var(--text-secondary);
            font-style: italic;
        }
        .npc-mood-tag {
            font-size: 0.7rem;
            padding: 2px 8px;
            border-radius: 10px;
            background: #3a2848;
            color: #c0a0d0;
            white-space: nowrap;
        }
        .affection-row {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.78rem;
            color: var(--text-secondary);
        }
        .affection-bar-outer {
            flex: 1;
            max-width: 120px;
            height: 6px;
            background: #2a1f35;
            border-radius: 3px;
            overflow: hidden;
        }
        .affection-bar-inner {
            height: 100%;
            background: linear-gradient(90deg, #d4a853, #f0c060);
            border-radius: 3px;
            transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .affection-num {
            font-weight: 700;
            color: var(--accent-glow);
            min-width: 30px;
            text-align: right;
            transition: var(--transition);
        }
        .affection-delta {
            position: absolute;
            font-weight: 700;
            font-size: 0.8rem;
            pointer-events: none;
            animation: float-up 1.5s ease-out forwards;
            z-index: 20;
            color: #f0c060;
        }
        @keyframes float-up {
            0% {
                opacity: 1;
                transform: translateY(0);
            }
            100% {
                opacity: 0;
                transform: translateY(-30px);
            }
        }

        /* ============ 主角状态面板（可展开） ============ */
        .player-panel-toggle {
            position: fixed;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            z-index: 90;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--player-bar-bg);
            border: 2px solid #3a5070;
            cursor: pointer;
            font-size: 1.3rem;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #8ab8e0;
            transition: var(--transition);
            box-shadow: var(--shadow);
        }
        .player-panel-toggle:hover {
            border-color: #5b9bd5;
            box-shadow: 0 0 20px rgba(91, 155, 213, 0.3);
        }
        .player-panel-toggle:active {
            transform: translateY(-50%) scale(0.9);
        }
        .player-panel-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 200;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s;
        }
        .player-panel-overlay.open {
            opacity: 1;
            pointer-events: auto;
        }
        .player-panel {
            position: fixed;
            right: -340px;
            top: 0;
            bottom: 0;
            width: 320px;
            max-width: 85vw;
            background: var(--player-bar-bg);
            border-left: 2px solid #3a5070;
            z-index: 210;
            transition: right 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            box-shadow: -8px 0 30px rgba(0, 0, 0, 0.6);
        }
        .player-panel.open {
            right: 0;
        }
        .player-panel-header {
            padding: 20px 18px 14px;
            border-bottom: 1px solid #2a4058;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            background: var(--player-bar-bg);
            z-index: 1;
        }
        .player-panel-header h3 {
            font-size: 1.1rem;
            color: #8ab8e0;
            letter-spacing: 1px;
        }
        .player-panel-close {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 1px solid #3a5070;
            background: transparent;
            color: #8ab8e0;
            cursor: pointer;
            font-size: 1rem;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .player-panel-close:hover {
            background: #d44;
            border-color: #d44;
            color: #fff;
        }
        .player-stat-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            padding: 16px 18px;
        }
        .player-stat-card {
            background: #0d1a28;
            border-radius: var(--radius-sm);
            padding: 12px;
            border: 1px solid #1e3045;
            transition: var(--transition);
        }
        .player-stat-card .stat-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #6a8daa;
            margin-bottom: 4px;
        }
        .player-stat-card .stat-value {
            font-size: 1.3rem;
            font-weight: 700;
            font-family: var(--font-mono);
        }
        .player-stat-card .stat-bar-outer {
            height: 4px;
            background: #1a3045;
            border-radius: 2px;
            margin-top: 6px;
            overflow: hidden;
        }
        .player-stat-card .stat-bar-inner {
            height: 100%;
            border-radius: 2px;
            transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .stat-hp {
            color: var(--hp-color);
        }
        .stat-hp .stat-bar-inner {
            background: var(--hp-color);
        }
        .stat-mp {
            color: var(--mp-color);
        }
        .stat-mp .stat-bar-inner {
            background: var(--mp-color);
        }
        .stat-gold {
            color: var(--gold-color);
        }
        .stat-exp {
            color: var(--exp-color);
        }
        .stat-exp .stat-bar-inner {
            background: var(--exp-color);
        }
        .player-items-section {
            padding: 0 18px 20px;
        }
        .player-items-section h4 {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #6a8daa;
            margin-bottom: 8px;
        }
        .player-items-list {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }
        .player-item-tag {
            font-size: 0.75rem;
            padding: 4px 10px;
            border-radius: 12px;
            background: #0d1a28;
            border: 1px solid #2a4058;
            color: #b0c8d8;
            transition: var(--transition);
        }
        .player-item-tag.new-item {
            animation: item-glow 0.8s ease-out;
            border-color: var(--gold-color);
            color: var(--gold-color);
        }
        @keyframes item-glow {
            0%,
            100% {
                box-shadow: 0 0 0px rgba(226, 176, 74, 0);
            }
            50% {
                box-shadow: 0 0 16px rgba(226, 176, 74, 0.6);
            }
        }

        /* ============ 对话区域 ============ */
        .chat-container {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            scroll-behavior: smooth;
            -webkit-overflow-scrolling: touch;
        }
        .chat-container::-webkit-scrollbar {
            width: 4px;
        }
        .chat-container::-webkit-scrollbar-track {
            background: transparent;
        }
        .chat-container::-webkit-scrollbar-thumb {
            background: #3a3040;
            border-radius: 2px;
        }
        .message-bubble {
            max-width: 85%;
            padding: 12px 16px;
            border-radius: 16px;
            line-height: 1.6;
            font-size: 0.9rem;
            word-break: break-word;
            animation: bubble-in 0.35s ease-out;
            position: relative;
        }
        @keyframes bubble-in {
            from {
                opacity: 0;
                transform: translateY(12px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .message-bubble.npc {
            align-self: flex-start;
            background: var(--npc-bubble);
            border: 1px solid #3a2848;
            border-bottom-left-radius: 4px;
            color: #e0d0e8;
        }
        .message-bubble.player {
            align-self: flex-end;
            background: var(--player-bubble);
            border: 1px solid #1e3050;
            border-bottom-right-radius: 4px;
            color: #c8d8e8;
        }
        .message-bubble .sender-label {
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
            opacity: 0.7;
        }
        .message-bubble.npc .sender-label {
            color: #c0a0d0;
        }
        .message-bubble.player .sender-label {
            color: #8ab8e0;
        }
        .message-bubble pre {
            background: #0d0d1a;
            border-radius: 6px;
            padding: 10px;
            overflow-x: auto;
            font-size: 0.8rem;
            border: 1px solid #2a2040;
            margin: 6px 0;
        }
        .message-bubble code {
            font-family: var(--font-mono);
            font-size: 0.82rem;
        }
        .message-bubble p {
            margin: 4px 0;
        }
        .message-bubble ul,
        .message-bubble ol {
            padding-left: 18px;
            margin: 4px 0;
        }
        .typing-cursor::after {
            content: '▌';
            animation: blink 0.8s step-end infinite;
            color: var(--accent);
        }
        @keyframes blink {
            50% {
                opacity: 0;
            }
        }

        /* 加载动画 */
        .loading-dots {
            display: flex;
            gap: 4px;
            padding: 8px 16px;
            align-self: flex-start;
        }
        .loading-dots span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--accent);
            animation: dot-bounce 1.2s ease-in-out infinite;
        }
        .loading-dots span:nth-child(2) {
            animation-delay: 0.15s;
        }
        .loading-dots span:nth-child(3) {
            animation-delay: 0.3s;
        }
        @keyframes dot-bounce {
            0%,
            80%,
            100% {
                transform: scale(0.6);
                opacity: 0.4;
            }
            40% {
                transform: scale(1);
                opacity: 1;
            }
        }

        /* ============ 选项区域 ============ */
        .options-container {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            padding: 10px 16px;
            justify-content: center;
            flex-shrink: 0;
            border-top: 1px solid var(--border);
            background: var(--bg-secondary);
            min-height: 50px;
            align-items: center;
        }
        .option-btn {
            padding: 10px 18px;
            border-radius: 20px;
            border: 1.5px solid var(--accent);
            background: transparent;
            color: var(--accent);
            cursor: pointer;
            font-size: 0.85rem;
            font-weight: 600;
            transition: var(--transition);
            letter-spacing: 0.3px;
            font-family: var(--font-ui);
            white-space: nowrap;
            position: relative;
            overflow: hidden;
        }
        .option-btn:hover {
            background: var(--accent);
            color: #1a1a2e;
            box-shadow: 0 0 20px rgba(212, 168, 83, 0.4);
            transform: translateY(-2px);
        }
        .option-btn:active {
            transform: scale(0.94);
            transition: 0.1s;
        }
        .option-btn:disabled {
            opacity: 0.35;
            cursor: not-allowed;
            pointer-events: none;
            border-color: #555;
            color: #777;
        }
        .option-btn .hotkey {
            display: inline-block;
            margin-right: 4px;
            font-size: 0.7rem;
            background: rgba(212, 168, 83, 0.2);
            padding: 1px 6px;
            border-radius: 3px;
            font-weight: 700;
        }
        .free-input-row {
            display: flex;
            gap: 8px;
            width: 100%;
            max-width: 500px;
            margin-top: 4px;
        }
        .free-input-row input {
            flex: 1;
            padding: 10px 14px;
            border-radius: 20px;
            border: 1px solid var(--border);
            background: var(--bg);
            color: var(--text);
            font-size: 0.85rem;
            font-family: var(--font-ui);
            outline: none;
            transition: var(--transition);
        }
        .free-input-row input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 10px rgba(212, 168, 83, 0.2);
        }
        .free-input-row button {
            padding: 10px 16px;
            border-radius: 20px;
            border: 1px solid var(--accent);
            background: var(--accent);
            color: #1a1a2e;
            cursor: pointer;
            font-weight: 700;
            font-size: 0.85rem;
            transition: var(--transition);
        }
        .free-input-row button:hover {
            box-shadow: 0 0 16px rgba(212, 168, 83, 0.5);
        }

        /* ============ 模态框 ============ */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.7);
            z-index: 300;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: fade-in 0.25s ease-out;
        }
        @keyframes fade-in {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }
        .modal {
            background: var(--bg-secondary);
            border-radius: var(--radius);
            padding: 24px;
            width: 90%;
            max-width: 460px;
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
            max-height: 85vh;
            overflow-y: auto;
        }
        .modal h3 {
            color: var(--accent);
            margin-bottom: 16px;
            font-size: 1.1rem;
        }
        .modal label {
            display: block;
            font-size: 0.8rem;
            color: var(--text-secondary);
            margin-bottom: 4px;
            letter-spacing: 0.5px;
        }
        .modal input,
        .modal textarea,
        .modal select {
            width: 100%;
            padding: 10px 14px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
            background: var(--bg);
            color: var(--text);
            font-size: 0.85rem;
            font-family: var(--font-ui);
            margin-bottom: 12px;
            outline: none;
            transition: var(--transition);
            resize: vertical;
        }
        .modal input:focus,
        .modal textarea:focus,
        .modal select:focus {
            border-color: var(--accent);
        }
        .modal textarea {
            min-height: 120px;
            font-family: var(--font-mono);
            font-size: 0.78rem;
            line-height: 1.5;
        }
        .modal .btn-row {
            display: flex;
            gap: 8px;
            justify-content: flex-end;
            flex-wrap: wrap;
        }
        .modal button {
            padding: 10px 20px;
            border-radius: 20px;
            border: 1px solid var(--accent);
            cursor: pointer;
            font-weight: 600;
            font-size: 0.85rem;
            transition: var(--transition);
            font-family: var(--font-ui);
        }
        .modal .btn-primary {
            background: var(--accent);
            color: #1a1a2e;
        }
        .modal .btn-primary:hover {
            box-shadow: 0 0 16px rgba(212, 168, 83, 0.4);
        }
        .modal .btn-secondary {
            background: transparent;
            color: var(--text-secondary);
            border-color: #555;
        }
        .modal .btn-secondary:hover {
            border-color: #999;
            color: #fff;
        }
        .modal .btn-danger {
            background: transparent;
            color: #d44;
            border-color: #d44;
        }
        .modal .btn-danger:hover {
            background: #d44;
            color: #fff;
        }

        /* Toast */
        .toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            background: #222;
            color: #fff;
            padding: 10px 22px;
            border-radius: 20px;
            font-size: 0.85rem;
            z-index: 400;
            pointer-events: none;
            animation: toast-in 0.35s ease-out, toast-out 0.35s 2s ease-in forwards;
            border: 1px solid #444;
            box-shadow: var(--shadow);
        }
        @keyframes toast-in {
            from {
                opacity: 0;
                transform: translateX(-50%) translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }
        }
        @keyframes toast-out {
            from {
                opacity: 1;
            }
            to {
                opacity: 0;
                transform: translateX(-50%) translateY(-10px);
            }
        }

        /* 响应式 */
        @media (max-width: 768px) {
            .npc-bar {
                padding: 8px 10px;
                gap: 8px;
            }
            .npc-avatar-frame {
                width: 40px;
                height: 40px;
                font-size: 1.5rem;
                border-width: 2px;
            }
